# ==============================================================================
# iMDB Admin — Modelo de variáveis de ambiente
#
# Copie este arquivo para `.env` e preencha com valores reais.
# Nunca commite o `.env` real no repositório (ver .gitignore).
# ==============================================================================

# Porta pública exposta pelo Nginx (única porta visível fora dos containers)
PORTA_NGINX=8080

# Banco de dados MySQL
MYSQL_ROOT_PASSWORD=defina-uma-senha-root
MYSQL_DATABASE=imdb
MYSQL_USER=imdb_app
MYSQL_PASSWORD=defina-uma-senha-do-app

# Autenticação JWT (segredo e tempo de expiração em segundos)
JWT_SECRET=defina-um-segredo-forte-e-aleatorio
JWT_EXPIRACAO=86400
